{
  "info": {
    "name": "Smart Room IoT — ESP8266 API",
    "description": "Chạy Spring Boot, MQTT broker và ESP8266 trước. Đăng nhập để lấy Bearer token; các API sau gửi Authorization: Bearer {{accessToken}}. Bốn LED: D6=FAN, D7=LIGHT, D1=LED3, D0=LED4. Lệnh trả HTTP 202; xem /api/actions để kiểm tra SUCCESS/FAILED sau tối đa 10 giây. Chỉ số RANDOM là dữ liệu mô phỏng do ESP8266 gửi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "lastActionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Xác thực",
      "item": [
        {
          "name": "01 Đăng nhập (chạy trước)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Đăng nhập thành công\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"accessToken\", pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Hồ sơ đăng nhập",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Đăng xuất",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Thiết bị — thao tác vật lý",
      "item": [
        {
          "name": "Danh sách thiết bị",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/actuators"
          }
        },
        {
          "name": "Bật đèn LED (D7)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/devices/LIGHT",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"ON\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lệnh được nhận\", function () { pm.response.to.have.status(202); });",
                  "if (pm.response.code === 202) pm.collectionVariables.set(\"lastActionId\", pm.response.json().actionId);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Tắt đèn LED (D7)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
